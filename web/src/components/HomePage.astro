---
import { translator } from "../i18n/index.js";
const { locale = "zh-CN" } = Astro.props;
const t = translator(locale);
const assetRoot = locale === "en" ? "../" : "./";
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <script is:inline src={assetRoot + "assets/language-redirect.js"}></script>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f5f1" />
    <meta
      name="description"
      content={t("QuotaFrame 把 Codex 和 Claude 的用量带到独立桌面屏。了解支持的设备，在浏览器中安装固件，并连接电脑端。")}
    />
    <title>{t("QuotaFrame — AI 编码额度，抬眼即见")}</title>
    <link rel="canonical" href={new URL(locale === 'en' ? '/en/' : '/', Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL('/', Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL('/en/', Astro.site)} />
    <link rel="alternate" hreflang="x-default" href={new URL('/', Astro.site)} />
    <link rel="icon" href={assetRoot + "assets/favicon.ico"} sizes="any" />
    <link rel="stylesheet" href={assetRoot + "assets/styles.css?v=3"} />
    <script is:inline type="module" src={assetRoot + "assets/app.js"}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t("跳到正文")}</a>
    <header class="site-header wrap">
      <a class="wordmark" href="./" aria-label={t("QuotaFrame 首页")}
        >QuotaFrame<span class="brand-period">.</span></a
      >
      <nav aria-label={t("主导航")}>
        <a href="#experience">{t("使用体验")}</a><a href="#setup">{t("开始使用")}</a
        ><a href="#desktop">{t("电脑端")}</a><a href="#compare">{t("设备对比")}</a>
        <a class="source-link" href="https://github.com/eMUQI/QuotaFrame"
          >GitHub</a
        >
        <select id="language-switch" aria-label={locale === "en" ? "Language" : "语言"}>
          <option value="zh-CN" lang="zh-CN" selected={locale === "zh-CN"}>简体中文</option>
          <option value="en" lang="en" selected={locale === "en"}>English</option>
        </select>
      </nav>
    </header>
    <main id="main">
      <section class="hero wrap" aria-labelledby="hero-title">
        <div class="hero-copy">
          <p class="eyebrow">A LITTLE SPACE FOR YOUR AI USAGE</p>
          <h1 id="hero-title">{t("AI 编码额度，")}<br />{t("抬眼即见。")}</h1>
          <p class="hero-description">
            {t("让 Codex 和 Claude 的用量，")}<br
              class="desktop-break"
            />{t("在桌面上有自己的位置。")}
          </p>
          <p class="hero-detail">
            {t("一块独立小屏，显示额度百分比与重置倒计时。")}<br
              class="desktop-break"
            />{t("少一次窗口切换，多一点专注。")}
          </p>
          <div class="actions">
            <a class="button primary" href="#setup">{t("设置我的设备")}</a
            ><a class="text-link" href="#desktop-shortcuts">{t("试试桌面交互")}</a>
          </div>
          <p class="hero-footnote">
            {t("开源项目 · 本地 Bridge · 加密蓝牙同步")}
          </p>
        </div>
        <figure class="product-figure" id="screen-demo">
          <button
            type="button"
            id="preview-toggle"
            class="preview-screen"
            aria-label={t("当前为额度总览，点击切换到 Codex 详情")}
          >
            <span id="preview-screen" class="qf-screen" aria-hidden="true"></span>
          </button>
          <div class="preview-picker" role="group" aria-label={t("选择预览界面")}>
            <button type="button" data-preview="overview" aria-pressed="true">{t("额度总览")}</button
            ><button type="button" data-preview="codex" aria-pressed="false">Codex</button
            ><button type="button" data-preview="claude" aria-pressed="false">Claude</button
            ><button type="button" data-preview="clock" aria-pressed="false">{t("时钟")}</button>
          </div>
          <figcaption>{t("界面实时还原 · 演示数据，非设备实拍")}</figcaption>
        </figure>
      </section>
      <section
        id="experience"
        class="experience wrap"
        aria-labelledby="experience-title"
      >
        <div class="section-intro">
          <p class="eyebrow">MADE FOR YOUR DESK</p>
          <h2 id="experience-title">{t("重要的信息，留在视线里。")}</h2>
          <p>
            {t("从电脑获取用量，通过蓝牙同步到小屏。")}<br />{t("电脑端需要持续运行，才能保持数据更新。")}
          </p>
        </div>
        <div class="benefits">
          <article>
            <span class="small-label">{t("01 / 一眼看全")}</span>
            <h3>{t("两个工具，一个总览")}</h3>
            <p>{t("把 Codex 和 Claude 放在一起，看清短期和每周用量。")}</p>
          </article>
          <article>
            <span class="small-label">{t("02 / 心里有数")}</span>
            <h3>{t("知道何时恢复额度")}</h3>
            <p>{t("百分比与重置倒计时同时显示，接近用量上限时更醒目。")}</p>
          </article>
          <article>
            <span class="small-label">{t("03 / 陪伴专注")}</span>
            <h3>{t("看时间，也留意额度")}</h3>
            <p>{t("微雪 AMOLED 时钟旁，两条进度显示用量。接近上限，百分比会醒目显示。")}</p>
          </article>
        </div>
      </section>
      <section id="setup" class="setup-section" aria-labelledby="setup-title">
        <div class="wrap setup-layout">
          <aside class="setup-intro">
            <p class="eyebrow">LET’S GET YOU CONNECTED</p>
            <h2 id="setup-title">{t("把小屏，")}<br />{t("变成 QuotaFrame。")}</h2>
            <p>{t("准备好设备和一根支持数据传输的 USB 线，从这里开始。")}</p>
            <ol class="journey" aria-label={t("设置流程")}>
              <li aria-current="step" data-journey="device">
                <span>1</span>
                <div>{t("选择设备")}<small>{t("核对手上的硬件型号")}</small></div>
              </li>
              <li data-journey="flash">
                <span>2</span>
                <div>{t("安装固件")}<small>{t("用 USB 连接并写入")}</small></div>
              </li>
              <li data-journey="desktop">
                <span>3</span>
                <div>{t("连接电脑端")}<small>{t("通过蓝牙开始同步")}</small></div>
              </li>
            </ol>
            <p class="setup-note">
              {t("已经在使用 QuotaFrame？")}<br />{t("Windows 可通过电脑端 OTA 更新；macOS 请使用 USB 更新。")}
            </p>
          </aside>
          <div class="setup-content">
            <section id="device-picker" aria-labelledby="device-title">
              <div class="section-heading">
                <div>
                  <p class="small-label">{t("第 1 步")}</p>
                  <h3 id="device-title">{t("选择你的设备")}</h3>
                </div>
                <span id="release-version" class="version-tag" hidden></span>
              </div>
              <p class="section-description">
                {t("按外观和完整型号核对。相同芯片的不同设备不能混用固件。")}
                <a class="text-link" href="#compare">{t("不确定选哪块？看设备对比")}</a>
              </p>
              <div id="target-grid" class="target-grid" aria-label={t("支持的设备")}>
                <p class="muted">{t("正在读取支持的设备…")}</p>
              </div>
              <p class="photo-credit">
                {t("设备图来自")}
                <a href="https://docs.m5stack.com/en/core/StickS3">M5Stack</a>{t("、")}
                <a href="https://docs.waveshare.com/ESP32-S3-Touch-AMOLED-2.16"
                  >{t("微雪官方文档")}</a
                >{t("与")}
                <a href="https://docs.espressif.com/projects/esp-dev-kits/en/latest/esp32s31/esp-mosaico/user_guide.html">{t("乐鑫官方文档")}</a>{t("，屏幕内容为厂商演示。")}
              </p>
            </section>
            <div
              id="load-error"
              class="error-message"
              role="alert"
              hidden
            ></div>
            <button
              id="reload-page"
              class="button secondary"
              type="button"
              hidden
            >
              {t("重新加载")}
            </button>
            <div id="device-summary" class="device-summary" hidden>
              <img id="chosen-device-image" width="64" height="64" alt="" />
              <div>
                <span class="small-label">{t("已选择设备")}</span
                ><strong id="chosen-device-name"></strong>
              </div>
              <button id="change-device" class="text-button" type="button">
                {t("更换设备")}
              </button>
            </div>
            <section
              id="flash-panel"
              class="flash-panel"
              aria-labelledby="flash-title"
              hidden
            >
              <div class="section-heading">
                <div>
                  <p class="small-label">{t("第 2 步")}</p>
                  <h3 id="flash-title" tabindex="-1">{t("安装固件")}</h3>
                </div>
                <span id="selected-version" class="version-tag"></span>
              </div>
              <p id="browser-support" class="browser-support" role="status"></p>
              <div id="install-options">
                <div class="preparation">
                  <h4>{t("先连接，再开始")}</h4>
                  <p>
                    {t("用 USB 数据线连接设备，关闭占用串口的程序。点击下方按钮后，在浏览器弹出的列表中选择这台设备。")}
                  </p>
                </div>
                <details class="firmware-details">
                  <summary>{t("固件与安装信息")}</summary>
                  <dl>
                    <dt>{t("设备")}</dt>
                    <dd id="selected-device"></dd>
                    <dt>{t("文件")}</dt>
                    <dd id="selected-image"></dd>
                    <dt>{t("安装方式")}</dt>
                    <dd>{t("完整镜像 · 从地址 0x0 写入")}</dd>
                  </dl>
                </details>
                <div class="erase-notice">
                  <label class="checkbox-row"
                    ><input id="erase-device" type="checkbox" checked /><span
                      >{t("安装前擦除设备")}<span class="input-hint"
                        >{t("清除设备上的原固件、配置和蓝牙绑定信息。")}</span
                      ></span
                    ></label
                  >
                  <details>
                    <summary>{t("已有设备？了解擦除与配对")}</summary>
                    <p>
                      {t("电脑上的蓝牙配对记录不会被擦除。安装后请删除电脑中的旧配对记录，再重新配对。")}
                    </p>
                    <p>
                      {t("取消勾选只会跳过整片擦除。本次仍写入完整镜像，不能保证保留设备配置或绑定信息。")}
                    </p>
                  </details>
                </div>
                <label class="checkbox-row confirmation"
                  ><input id="confirm-target" type="checkbox" /><span
                    >{t("我已核对设备型号，了解本次安装会覆盖固件，并可能重置配置与绑定信息。")}</span
                  ></label
                >
              </div>
              <section
                id="flash-progress"
                class="flash-progress"
                aria-labelledby="progress-title"
                hidden
              >
                <div class="progress-heading">
                  <h4 id="progress-title" tabindex="-1">{t("准备连接")}</h4>
                  <span id="progress-percentage"></span>
                </div>
                <p
                  id="progress-message"
                  role="status"
                  aria-live="polite"
                  aria-atomic="true"
                ></p>
                <ol class="progress-steps" aria-label={t("安装进度")}>
                  <li data-phase="initializing">
                    <span>{t("连接设备")}</span><small>{t("等待开始")}</small>
                  </li>
                  <li data-phase="preparing">
                    <span>{t("下载固件")}</span><small>{t("等待开始")}</small>
                  </li>
                  <li data-phase="erasing">
                    <span>{t("擦除设备")}</span><small>{t("等待开始")}</small>
                  </li>
                  <li data-phase="writing">
                    <span>{t("写入固件")}</span><small>{t("等待开始")}</small>
                  </li>
                  <li data-phase="finished">
                    <span>{t("复位设备")}</span><small>{t("等待开始")}</small>
                  </li>
                </ol>
                <progress
                  id="write-progress"
                  max="100"
                  value="0"
                  aria-label={t("固件写入进度")}
                  hidden
                ></progress>
                <div
                  id="flash-error"
                  class="error-message"
                  role="alert"
                  hidden
                ></div>
                <a
                  id="continue-desktop"
                  class="button primary"
                  href="#desktop"
                  hidden
                  >{t("下一步：连接电脑端")}</a
                >
              </section>
              <div id="install-control">
                <button
                  id="install-button"
                  class="button primary install-button"
                  type="button"
                  disabled
                >
                  {t("连接设备并安装")}
                </button>
              </div>
              <p class="install-caption">
                {t("烧录时请保持页面打开、电脑唤醒和 USB 连接稳定。")}
              </p>
              <details id="flash-recovery" class="recovery">
                <summary>{t("连接或安装遇到了问题？")}</summary>
                <ul>
                  <li>
                    <strong>{t("列表里没有设备：")}</strong>{t("确认 USB 线支持数据传输，尝试其他 USB 接口，并检查设备所需驱动。")}
                  </li>
                  <li>
                    <strong>{t("连接失败：")}</strong
                    >{t("关闭占用串口的终端、烧录程序或其他浏览器标签。按设备厂商说明进入下载模式，再次连接。")}
                  </li>
                  <li>
                    <strong>{t("下载失败：")}</strong
                    >{t("检查网络后重试。设备已经擦除或开始写入时，请重新完成安装。")}
                  </li>
                  <li>
                    <strong>{t("型号或芯片不匹配：")}</strong
                    >{t("返回核对设备型号，不要绕过校验安装其他设备的固件。")}
                  </li>
                  <li>
                    <strong>{t("写入中断：")}</strong
                    >{t("保持供电稳定，重新连接并安装。已擦除的数据不会恢复。")}
                  </li>
                  <li>
                    <strong>{t("安装完成但屏幕没变化：")}</strong
                    >{t("尝试重新上电；写入完成并不代表设备已成功启动。仍有问题时查看设备文档。")}
                  </li>
                </ul>
                <a
                  href="https://github.com/eMUQI/QuotaFrame/blob/main/README.md"
                  >{t("查看设备说明与手动安装方法")}</a
                >
              </details>
            </section>
          </div>
        </div>
      </section>
      <section
        id="desktop"
        class="desktop-section wrap"
        aria-labelledby="desktop-title"
      >
        <div class="section-intro">
          <p class="eyebrow">ONE LAST CONNECTION</p>
          <h2 id="desktop-title">{t("在电脑上连接它。")}</h2>
          <p>{t("固件安装好后，完成这三件事，")}<br />{t("让用量从电脑走到桌面。")}</p>
        </div>
        <div class="desktop-content">
          <div class="desktop-guide">
            <div class="platform-picker" role="group" aria-label={t("选择电脑系统")}>
              <button type="button" data-platform="mac" aria-pressed="true">
                macOS</button
              ><button type="button" data-platform="windows" aria-pressed="false">
                Windows
              </button>
            </div>
            <p id="platform-requirement" class="platform-requirement">
              {t("macOS 14 或更新版本 · 仅 Apple Silicon · 需要蓝牙")}
            </p>
            <ol class="desktop-steps">
              <li>
                <div>
                  <h3>{t("准备好用量来源")}</h3>
                  <p>
                    {t("安装")}
                    <a
                      id="source-download"
                      href="https://github.com/steipete/CodexBar"
                      >CodexBar</a
                    >{t("，登录所用账号，确认能正常显示用量。")}
                  </p>
                  <p id="source-cli-hint">
                    {t("在 CodexBar 的 Preferences → Advanced 中选择 Install CLI，让电脑端能够读取用量。")}
                  </p>
                </div>
              </li>
              <li>
                <div>
                  <h3>{t("安装 QuotaFrame 电脑端")}</h3>
                  <p id="desktop-download-hint">
                    {t("在发布页下载 macos-arm64 .dmg 安装包，安装并打开 QuotaFrame Bridge。")}
                  </p>
                  <a
                    class="button secondary"
                    href="https://github.com/eMUQI/QuotaFrame/releases/latest"
                    >{t("前往下载电脑端")}</a
                  >
                </div>
              </li>
              <li>
                <div>
                  <h3>{t("添加设备，开始同步")}</h3>
                  <p>
                    {t("在电脑端添加蓝牙设备，按提示完成配对。屏幕出现用量百分比和重置倒计时，就可以开始使用了。")}
                  </p>
                </div>
              </li>
            </ol>
            <p class="muted desktop-help">
              {t("重新烧录过设备？先删除电脑中的旧蓝牙配对记录。")}<a
                href="https://github.com/eMUQI/QuotaFrame/blob/main/bridge/README.md"
                >{t("完整电脑端指南")}</a
              >
            </p>
          </div>
          <section id="desktop-shortcuts" class="desktop-shortcuts" aria-labelledby="shortcuts-title">
            <h3 id="shortcuts-title">{t("试试 Bridge 的快捷操作")}</h3>
            <p class="demo-intro">{t("在 macOS 菜单栏或 Windows 托盘，点击或滚动 Bridge 图标，就能控制小屏。")}</p>
            <div class="bridge-demo">
              <figure class="demo-screen">
                <div id="demo-screen" class="qf-screen" role="img" aria-label={t("额度总览：Codex 和 Claude 的短期与每周用量。")}></div>
                <figcaption id="demo-status" role="status">{t("额度总览")}</figcaption>
              </figure>
              <div class="demo-controls">
                <span class="small-label">{t("Bridge 图标")}</span>
                <button id="demo-tray" type="button" aria-label={t("Bridge 图标：切换时钟")} aria-pressed="false" aria-describedby="demo-hint" aria-keyshortcuts="ArrowUp ArrowDown">
                  <img src={assetRoot + "assets/favicon.ico"} width="24" height="24" alt="" />
                  <span>Bridge</span>
                </button>
                <p id="demo-hint">{t("左键单击，切换时钟。")}<br />{t("在图标上滚动，翻看额度。")}</p>
                <div class="demo-paging" role="group" aria-label={t("演示翻页")}>
                  <button id="demo-previous" type="button">{t("上一页")}</button>
                  <button id="demo-next" type="button">{t("下一页")}</button>
                </div>
              </div>
            </div>
            <p class="demo-note">{t("演示使用示例数据，无需连接设备。实际操作需配套 Bridge 与固件，并作用于所有已连接且支持相应功能的设备。")}</p>
          </section>
        </div>
      </section>
      <section id="compare" class="compare wrap" aria-labelledby="compare-title">
        <div class="section-intro">
          <p class="eyebrow">CHOOSE YOUR SCREEN</p>
          <h2 id="compare-title">{t("四块小屏，各有所长。")}</h2>
          <p>{t("显示内容相同，差别在屏幕与交互。")}</p>
        </div>
        <p class="compare-hint" aria-hidden="true">{t("左右滑动查看全部设备 →")}</p>
        <div class="compare-scroll" tabindex="0" role="region" aria-labelledby="compare-title">
          <table class="compare-table">
            <thead>
              <tr>
                <td></td>
                <th scope="col"><img src={assetRoot + "assets/devices/waveshare_amoled_216.jpg"} alt="" loading="lazy" /><small>{t("微雪")}</small>AMOLED 2.16</th>
                <th scope="col"><img src={assetRoot + "assets/devices/m5sticks3.jpg"} alt="" loading="lazy" /><small>M5Stack</small>StickS3</th>
                <th scope="col"><img src={assetRoot + "assets/devices/waveshare_epaper_397.jpg"} alt="" loading="lazy" /><small>{t("微雪")}</small>ePaper 3.97</th>
                <th scope="col"><img src={assetRoot + "assets/devices/esp_mosaico.png"} alt="" loading="lazy" /><small>{t("乐鑫")}</small>ESP-Mosaico</th>
              </tr>
            </thead>
            <tbody>
              <tr><th scope="row">{t("屏幕")}</th><td>{t("480 × 480 圆角方形 AMOLED")}</td><td>135 × 240 LCD</td><td>{t("800 × 480 四灰阶墨水屏")}</td><td>480 × 480 AMOLED</td></tr>
              <tr><th scope="row">{t("用量页面")}</th><td>{t("总览 / Codex / Claude")}</td><td>{t("总览 / Codex / Claude")}</td><td>{t("主页同屏显示 Codex 与 Claude，另有趋势页")}</td><td>{t("总览 / Codex / Claude")}</td></tr>
              <tr><th scope="row">{t("翻页")}</th><td>{t("触控标签、左右滑动")}</td><td>{t("正面按键")}</td><td>{t("三向拨轮")}</td><td>{t("触控标签、左右滑动、AI 键")}</td></tr>
              <tr><th scope="row">{t("时钟屏保")}</th><td><span aria-hidden="true">✓</span><span class="sr-only">{t("支持")}</span></td><td class="compare-no"><span aria-hidden="true">—</span><span class="sr-only">{t("不支持")}</span></td><td><span aria-hidden="true">✓</span><span class="sr-only">{t("支持")}</span></td><td><span aria-hidden="true">✓</span><span class="sr-only">{t("支持")}</span><small>{t("断电后需电脑端重新校时")}</small></td></tr>
