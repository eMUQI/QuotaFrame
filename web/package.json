  "dependencies": {
    "esp-web-tools": "10.4.0"
  },
  "devDependencies": {
    "astro": "7.3.4",
    "esbuild": "0.25.10",
    "jsdom": "30.0.1"
  },
  "overrides": {
    "esptool-js": "https://codeload.github.com/espressif/esptool-js/tar.gz/5f860b71218fb30aa33a3d039039c496862c360f"
  }
